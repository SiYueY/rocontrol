<mujoco model="cartesian_arm">
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 0"/>
  <worldbody>
    <body name="link1" pos="0 0 0.2">
      <joint name="joint1" type="hinge" axis="0 0 1" range="-1 1"/>
      <inertial pos="0.2 0 0" mass="1" diaginertia="0.1 0.1 0.1"/>
      <body name="link2" pos="0.4 0 0">
        <joint name="joint2" type="hinge" axis="0 1 0" range="-1 1"/>
        <inertial pos="0.15 0 0" mass="1" diaginertia="0.1 0.1 0.1"/>
        <body name="tool" pos="0.3 0 0"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="motor1" joint="joint1" ctrlrange="-20 20"/>
    <motor name="motor2" joint="joint2" ctrlrange="-20 20"/>
  </actuator>
</mujoco>
